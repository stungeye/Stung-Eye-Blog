// www.stungeye.com on Cloudflare Workers (Phase C, PLAN C3.6 / F35).
// Built by Workers Builds from main: `npm ci && npm run build` (F8).
{
  "name": "static-www-stungeye-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,  // off after the www cutover (R11, F38)
  "preview_urls": false,
  // www cutover (PLAN C3.8, F37, owner-confirmed 2026-10-31). /sounds and /sounds/* are
  // routed to static-www-stungeye-com-sounds, which outranks this. Rollback: remove this.
  "routes": [
    { "pattern": "www.stungeye.com/*", "zone_name": "stungeye.com" }
  ]
}
